# ==============================================================================
# SNORT 3 CUSTOM DETECTION TEMPLATE - COMMON ATTACK PATTERNS
# SID Range: 1000001 - 1000016
# ==============================================================================

# 1. RECONNAISSANCE & PORT SCANNING
alert tcp $EXTERNAL_NET any -> $HOME_NET any ( msg:"RECON Nmap XMAS Scan Detected"; flags:FPU; classtype:attempted-recon; sid:1000001; rev:4; )
alert tcp $EXTERNAL_NET any -> $HOME_NET any ( msg:"RECON Nmap NULL Scan Detected"; flags:0; classtype:attempted-recon; sid:1000002; rev:4; )
alert icmp $EXTERNAL_NET any -> $HOME_NET any ( msg:"RECON ICMP Ping Sweep Detected"; itype:8; detection_filter:track by_src, count 10, seconds 5; classtype:attempted-recon; sid:1000003; rev:4; )

# 2. BRUTE FORCE & CREDENTIAL ATTACKS
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 ( msg:"BRUTE-FORCE Potential SSH Brute Force"; flags:S; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000004; rev:4; )
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 ( msg:"BRUTE-FORCE Potential RDP Brute Force"; flags:S; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000005; rev:4; )

# 3. WEB APPLICATION ATTACKS
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"WEB-ATTACK SQL Injection UNION SELECT in URI"; flow:to_server,established; http_uri; content:"UNION",nocase; content:"SELECT",nocase,distance 0; classtype:web-application-attack; sid:1000006; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"WEB-ATTACK SQL Injection Auth Bypass Attempt"; flow:to_server,established; http_client_body; content:"1=1"; pcre:"/(\x27|%27)\s*or\s*1\s*=\s*1/i"; classtype:web-application-attack; sid:1000007; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"WEB-ATTACK Cross-Site Scripting (XSS) Script Tag in URI"; flow:to_server,established; http_uri; content:"<script>",nocase; classtype:web-application-attack; sid:1000008; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"WEB-ATTACK Directory Traversal Attempt"; flow:to_server,established; http_uri; content:"../"; classtype:web-application-attack; sid:1000009; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"WEB-ATTACK LFI Attempt Targeting /etc/passwd"; flow:to_server,established; http_uri; content:"/etc/passwd",nocase; classtype:web-application-attack; sid:1000010; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"WEB-ATTACK OS Command Injection Attempt"; flow:to_server,established; http_uri; pcre:"/(\x3b|\x7c|\x60|\$\()\s*(cat|ls|id|whoami|uname|wget|curl)/i"; classtype:web-application-attack; sid:1000011; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"EXPLOIT Log4Shell JNDI Lookup in HTTP Header"; flow:to_server,established; http_header; content:"${jndi:",nocase; classtype:attempted-user; sid:1000012; rev:4; )
alert http $EXTERNAL_NET any -> $HOME_NET any ( msg:"RECON Automated Web Vulnerability Scanner Detected"; flow:to_server,established; http_header:field user-agent; pcre:"/(sqlmap|nikto|gobuster|dirbuster|nmap|masscan)/i"; classtype:attempted-recon; sid:1000013; rev:4; )

# 4. MALWARE, C2 & EXFILTRATION
alert http $HOME_NET any -> $EXTERNAL_NET any ( msg:"MALWARE Executable (.exe) Requested over HTTP"; flow:to_server,established; http_uri; content:".exe",nocase; classtype:trojan-activity; sid:1000014; rev:4; )
alert tcp $HOME_NET any -> $EXTERNAL_NET any ( msg:"MALWARE Outbound Bash Reverse Shell Detected"; flow:to_server,established; content:"/bin/bash -i",nocase; classtype:trojan-activity; sid:1000015; rev:4; )
alert udp $HOME_NET any -> any 53 ( msg:"EXFIL Potential DNS Tunneling - Oversized Query"; dsize:>80; classtype:policy-violation; sid:1000016; rev:4; )

# ------------------------------------------------------------------------------
# 5. CERBER RANSOMWARE C2 CHECK-IN & STAGING
# ------------------------------------------------------------------------------

# Detect Classic Cerber Ransomware UDP Check-in Beacon (Ports 6892-6893)
alert udp $HOME_NET any -> $EXTERNAL_NET 6892:6893 ( msg:"MALWARE Cerber Ransomware UDP C2 Check-in Beacon"; dsize:>10; detection_filter:track by_src, count 3, seconds 10; classtype:trojan-activity; sid:1000017; rev:1; )

# Detect Cerber UDP Check-in Single Packet (If testing a short PCAP with 1-2 packets)
alert udp any any -> any 6892:6893 ( msg:"MALWARE Cerber Ransomware UDP Port 6892-6893 Traffic"; classtype:trojan-activity; sid:1000018; rev:1; )

# Detect Cerber HTTP Payload Staging (agttydck / .bat / .exe check-in)
alert http any any -> any any ( msg:"MALWARE Cerber Ransomware HTTP C2 Payload Request"; flow:to_server,established; http_uri; content:"/agttydck",nocase; classtype:trojan-activity; sid:1000019; rev:1; )

# ------------------------------------------------------------------------------
# 6. EVIL REDIRECTOR DOMAIN & RIG EXPLOIT KIT (RIG EK)
# ------------------------------------------------------------------------------

# 1. Detect Evil Redirector via Malicious Iframe Injection in Compromised Site
alert http any any -> any any ( msg:"EXPLOIT-KIT Evil Redirector Hidden Iframe Injection"; flow:to_client,established; file_data; content:"<iframe",nocase; content:"src=",nocase,distance 0; pcre:"/<iframe[^>]+style\s*=\s*[\x22\x27][^>\x22\x27]*(display\s*:\s*none|visibility\s*:\s*hidden|width\s*:\s*[01]px|height\s*:\s*[01]px)/i"; classtype:trojan-activity; sid:1000020; rev:1; )

# 2. Detect Evil Redirector / Gate Traffic (Suspicious Referer to Gate PHP/HTML)
alert http any any -> any any ( msg:"EXPLOIT-KIT Suspicious Redirector Gate Request"; flow:to_server,established; http_header; content:"Referer:",nocase; http_uri; pcre:"/^\/[a-z0-9]{1,8}\.(php|html)\?[a-z0-9]{1,6}=[a-zA-Z0-9_\-]{15,}/i"; classtype:trojan-activity; sid:1000021; rev:1; )

# 3. Detect RIG Exploit Kit Landing Page (Classic Long Pseudo-Random URI Parameters)
alert http any any -> any any ( msg:"EXPLOIT-KIT RIG EK Landing Page URI Pattern"; flow:to_server,established; http_uri; pcre:"/^\/(\?[a-zA-Z0-9_\-]{40,}|index\.php\?[a-zA-Z0-9_\-]{40,})$/"; classtype:exploit-kit; sid:1000022; rev:1; )

# 4. Detect RIG Exploit Kit Landing Page Response (Obfuscated VBScript / Flash Embed)
alert http any any -> any any ( msg:"EXPLOIT-KIT RIG EK Landing Page Obfuscated VBScript"; flow:to_client,established; file_data; content:"vbscript",nocase; content:"CreateObject",nocase; pcre:"/(Execute|Eval|ChrW?\s*\()/i"; classtype:exploit-kit; sid:1000023; rev:1; )

# 5. Detect RIG Exploit Kit Flash (.swf) Exploit Delivery
alert http any any -> any any ( msg:"EXPLOIT-KIT RIG EK Flash Exploit (.swf) Delivery"; flow:to_client,established; file_data; content:"CWS",depth 3; classtype:exploit-kit; sid:1000024; rev:2; )
alert http any any -> any any ( msg:"EXPLOIT-KIT RIG EK Encrypted Binary Payload Download"; flow:to_client,established; http_header; content:"Content-Type: application/octet-stream",nocase; http_uri; pcre:"/\?[a-zA-Z0-9_\-]{30,}/"; classtype:trojan-activity; sid:1000025; rev:2; )